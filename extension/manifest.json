{
  "manifest_version": 3,
  "name": "Varnelė",
  "version": "0.1.0",
  "description": "Lithuanian spelling and grammar in every text field. Everything is checked on this computer; no text leaves it.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Varnelė" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
